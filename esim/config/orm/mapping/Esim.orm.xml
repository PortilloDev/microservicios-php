<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Entity\Esim" table="esim">
        <id name="id" type="string" column-definition="CHAR(36) NOT NULL"/>

        <field name="orderId" length="36"/>
        <field name="userEmail" length="100"/>
        <field name="provider" length="32"/>
        <field name="status" length="32"/>
        <field name="paymentId" length="36" nullable="true"/>
        <field name="iccid" length="22" nullable="true"/>
        <field name="imsi" length="20" nullable="true"/>
        <field name="msisdn" length="20" nullable="true"/>
        <field name="smdpAddress" length="120" nullable="true"/>
        <field name="matchingId" length="64" nullable="true"/>
        <field name="activationCode" length="255" nullable="true"/>
        <field name="qrCodeUrl" length="500" nullable="true"/>
        <field name="profileName" length="120" nullable="true"/>
        <field name="dataAllowance" length="32" nullable="true"/>
        <field name="validity" length="32" nullable="true"/>
        <field name="failureMessage" length="255" nullable="true"/>
        <field name="createdAt" type="datetime" column-definition="DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP" />
        <field name="updatedAt" type="datetime" column-definition="DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP" />
    </entity>
</doctrine-mapping>

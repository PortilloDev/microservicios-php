<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Entity\Refund" table="refund">
        <id name="id" type="string" column-definition="CHAR(36) NOT NULL"/>

        <many-to-one field="payment" target-entity="App\Entity\Payment" inversed-by="refunds" fetch="LAZY">
            <join-columns>
                <join-column name="payment_id" referenced-column-name="id" nullable="false"/>
            </join-columns>
        </many-to-one>

        <field name="amount" type="integer"/>
        <field name="status" length="32"/>
        <field name="providerRefundId" length="64" nullable="true"/>
        <field name="createdAt" type="datetime" column-definition="DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP" />
    </entity>
</doctrine-mapping>

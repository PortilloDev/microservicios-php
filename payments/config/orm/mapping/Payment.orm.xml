<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Entity\Payment" table="payment">
        <id name="id" type="string" column-definition="CHAR(36) NOT NULL"/>

        <field name="orderId" length="36"/>
        <field name="userEmail" length="100"/>
        <field name="amount" type="integer"/>
        <field name="currency" length="3"/>
        <field name="paymentMethod" length="64"/>
        <field name="provider" length="32"/>
        <field name="idempotencyKey" length="120"/>
        <field name="status" length="32"/>
        <field name="providerPaymentIntentId" length="64" nullable="true"/>
        <field name="providerChargeId" length="64" nullable="true"/>
        <field name="failureCode" length="64" nullable="true"/>
        <field name="failureMessage" length="255" nullable="true"/>
        <field name="createdAt" type="datetime" column-definition="DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP" />
        <field name="updatedAt" type="datetime" column-definition="DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP" />

        <one-to-many field="refunds" target-entity="App\Entity\Refund" mapped-by="payment" fetch="LAZY">
            <cascade>
                <cascade-all/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
